<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- This project opts out of CPM (ManagePackageVersionsCentrally=false), so the central
         System.Security.Cryptography.Xml pin does not apply here; the vulnerable 8.0.3 flows
         transitively from the Common submodule's direct floor. Direct reference mirrors the
         central 8.0.4 pin (2026-07 advisory wave: CVE-2026-50527 / CVE-2026-47304 et al.) —
         drop once the Common submodule repin (>= 8.0.4 floor) lands. -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="8.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.3.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\ext\Lidarr.Plugin.Common\testkit\Lidarr.Plugin.Common.TestKit.csproj" />
    <!-- Build the plugin WITHOUT the post-build ILRepack/RepackPlugin step so its types resolve to the
         standalone Common/Abstractions the TestKit references (not the internalized copies in the merged
         DLL). Mirrors the amazon parity-test pattern; otherwise the cross-identity type scan can trip a
         ReflectionTypeLoadException once ILRepack is enabled. -->
    <ProjectReference Include="..\..\Qobuzarr.csproj">
      <AdditionalProperties>PluginPackagingDisable=true;OutputPath=bin-tests\;EnablePluginDeployment=false</AdditionalProperties>
    </ProjectReference>
  </ItemGroup>
</Project>
